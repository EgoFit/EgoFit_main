DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOW_INSECURE_DEV_SECRET=false
DJANGO_AUTO_MIGRATE_ON_STARTUP=false
DJANGO_AUTO_COLLECTSTATIC_ON_STARTUP=false
DJANGO_TASK_QUEUE_REQUIRED=true
DJANGO_TASKS_RUN_INLINE=false
